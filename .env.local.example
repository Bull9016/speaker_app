# Copy this file to .env.local and fill in your Supabase project details
# Required for frontend Supabase usage (used by the Next.js app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: service role key for server-side scripts (keep secret)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: SendGrid API key for email sending (used in API routes)
# SENDGRID_API_KEY=your-sendgrid-key
